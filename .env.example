# Swipe — yerel geliştirme ve Supabase bağlantısı
# Doldurulacak ilk üç alan: DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY.
# Değerleri = işaretinin sağına yaz. Gizli bilgileri paylaşma veya Git'e ekleme.

# 1) SUPABASE VERİTABANI — yalnızca sunucuda kullanılır
# Projenin Connect bölümündeki Direct veya Session pooler bağlantısını kullan.
# Transaction pooler kullanma. Veritabanı parolasındaki özel karakterler URI-encode edilmeli.
# Örnek: postgresql://postgres.PROJECT:ENCODED_PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Boşken uygulama yerel PGlite veritabanını kullanır; buluta bağlanmış olmaz.
DATABASE_URL=
# Yalnızca bağlantının gerektirdiği güvenilir CA sertifikası varsa doldur.
# PEM metni çift tırnak içinde, satır araları \n olacak şekilde girilebilir.
# TLS doğrulamasını kapatma.
DATABASE_CA_CERT=

# 2) SUPABASE MEDYA DEPOLAMA — bu iki alanı birlikte doldur
# Proje URL'si; sonunda / olmamalı. Örnek: https://PROJECT.supabase.co
SUPABASE_URL=
# Sunucuya ait service_role anahtarı; anon/publishable anahtarını buraya yazma.
SUPABASE_SERVICE_ROLE_KEY=
# İlk medya yüklemesinde sunucu tarafından oluşturulur.
SUPABASE_STORAGE_BUCKET=product-media

# 3) GEMINI — isteğe bağlı; boşken ücretli AI çağrısı yapılmaz
GEMINI_API_KEY=
AI_MONTHLY_BUDGET_USD=25
# Anahtar eklendiğinde API içindeki worker yeni ürün analizlerini işler.
AI_WORKER=true
FEED_PERSONALIZED=true

# 4) API VE UYGULAMA — geliştirme varsayılanları
NODE_ENV=development
PORT=3001
# Boşken web localhost'u, native uygulama Expo sunucusunun adresini kullanır.
# Fiziksel cihaz için gerekirse http://BILGISAYARIN_LAN_IP_ADRESI:3001 yaz.
# Bu alan uygulamaya gömülür; gizli bilgi içeremez.
EXPO_PUBLIC_API_URL=
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
# Gerçek ödeme yoktur. demo: demo sipariş açık; boş: checkout kapalı.
CHECKOUT_MODE=demo
# Buluta otomatik örnek veri yazılmasını engeller. Mevcut yerel ürünleri silmez.
# Boş bir geliştirme veritabanına örnek ürün eklemek istersen true yap.
SEED_DEMO=false

# 5) YEREL DOSYALAR — bulut bağlantısı yokken kullanılan dizinler
PGLITE_DIR=server/data/postgres
UPLOAD_DIR=server/data/uploads
# Yalnızca eski SQLite aktarım aracı içindir; güncel veri kaynağı PostgreSQL'dir.
# Güncel verileri taşımak için eski SQLite aktarımını yeniden çalıştırma.
SQLITE_SOURCE=server/data/swipe.db

# Resend: only server-side. Use a sender on your verified Resend domain.
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_ORIGIN=http://localhost:8082
