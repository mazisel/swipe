# Enter these values in Portainer > Stack > Environment variables.
SWIPE_IMAGE_PREFIX=ghcr.io/mazisel/swipe
# Prefer a tested sha-<40 character commit> for repeatable releases.
SWIPE_TAG=latest
PUBLIC_ORIGIN=https://swipe.example.com
# Loopback by default; an HTTPS reverse proxy on the host forwards here.
SWIPE_BIND_IP=127.0.0.1
SWIPE_PORT=8080
DATABASE_URL=
# Optional PEM override. The image already contains the public Supabase CA.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-media
GEMINI_API_KEY=
AI_MONTHLY_BUDGET_USD=25
AI_WORKER=true
FEED_PERSONALIZED=true
CHECKOUT_MODE=demo
